#!/bin/bash
# pre-push hook — 密钥扫描 + 大文件拦截 + 集成测试（tag 推时跑全部测试）
set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'
VIOLATIONS=0

# 读取推入的 refs（stdin 只能消费一次）
IS_TAG_PUSH=false
RANGES=()
while read -r local_ref local_oid remote_ref remote_oid; do
    ZERO="0000000000000000000000000000000000000000"
    if [ "$local_oid" != "$ZERO" ] && [ "$remote_oid" != "$ZERO" ]; then
        RANGES+=("$remote_oid..$local_oid")
    elif [ "$local_oid" != "$ZERO" ]; then
        # 新分支 — 只检查**远端还没有的** commit。
        #
        # ⛔ 这里原本是 `RANGES+=("$local_oid")`,而 `git rev-list <oid>` 是
        # **整个历史**,不是「这个分支新增的东西」。实测:推一个只改了 1 个文件的
        # 新分支,它要扫 756 个 commit(正确答案是 1 个)。
        #
        # ⚠️ 后果不是「慢一点」,是**任何新分支都推不上去**:那 756 个 commit 里
        # 有 internal/web/dist/assets/*.js —— 前端 minified bundle,里面的
        # `password:"…"` / `api_key:…` 必然命中下面的密钥正则,于是 VIOLATIONS>0
        # 直接 exit 1。而 `echo "$match" | head -2` 打印两行 minified JS 是 121 KB,
        # 把真正的失败原因冲得无影无踪。
        #
        # ⭐ 那些 dist 产物今天已经出库(git ls-files 里是 0),但**历史里的 20 份还在**,
        # 而这里扫的是历史 —— 所以「产物出库」并不会让这个问题自己消失。
        RANGES+=("$local_oid --not --remotes=origin")
    fi
    if echo "$local_ref" | grep -Eq "^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+"; then
        IS_TAG_PUSH=true
    fi
done

# ─── 1. 密钥扫描（扫描推送范围内的所有 commit）─────────────
echo "→ Scanning pushed commits for secrets..."
SECRET_PATTERNS=(
    'ed25519:[[:space:]]*[0-9a-fA-F]{64,128}'
    'private_key:[[:space:]]*"?0x[0-9a-fA-F]{64}"?'
    'keystore_password:[[:space:]]*"[^"]{8,}"'
    'password:[[:space:]]*"[^"]{8,}"'
    'api_key:[[:space:]]*"?[A-Za-z0-9+/=]{32,}"?'
    '-----BEGIN\s+(RSA|EC|DSA|OPENSSH|PRIVATE)\s+KEY-----'
    '(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}'
    'sk-[A-Za-z0-9]{20,}'
)

EXCLUDE_REGEX='(extension/|tests/|__tests__/|test_|\.spec\.|mock|fixtures|factories|testdata/|e2e/|\.env\.example|\.example|\.gitignore|node_modules)'

for range in "${RANGES[@]}"; do
    # ⛔ $range 故意不加引号:新分支那一档是 `<oid> --not --remotes=origin`,
    # 是三个参数。加引号会被当成单个 revision,git 报
    # `fatal: ambiguous argument` —— 而它被 2>/dev/null 吞掉,循环空转,于是
    # **密钥扫描静默地什么都没扫**,还照样打印 "✅ No secrets detected."
    for commit in $(git rev-list $range 2>/dev/null); do
        for f in $(git diff --name-only "$commit^" "$commit" 2>/dev/null); do
            echo "$f" | grep -Eq "$EXCLUDE_REGEX" && continue
            content=$(git show "$commit:$f" 2>/dev/null || true)
            for pattern in "${SECRET_PATTERNS[@]}"; do
                match=$(echo "$content" | grep -Pn -- "$pattern" || true)
                if [ -n "$match" ]; then
                    echo -e "${RED}⚠ SECRET in ${f} (commit ${commit:0:8}):${NC}"
                    echo "$match" | head -2
                    VIOLATIONS=$((VIOLATIONS + 1))
                fi
            done
        done
    done
done

if [ $VIOLATIONS -gt 0 ]; then
    echo -e "${RED}❌ Found $VIOLATIONS secret(s). Push rejected.${NC}"
    exit 1
fi
echo "   ✅ No secrets detected."

# ─── 2. 大文件拦截 ──────────────────────────────────────────
echo "→ Checking for large files..."
LARGE_COUNT=0
MAX_SIZE=$((50 * 1024 * 1024))

for range in "${RANGES[@]}"; do
    # ⛔ 同上,$range 不加引号 —— 理由见密钥扫描那一处。
    git rev-list --objects $range 2>/dev/null | while read -r sha path; do
        [ -z "$path" ] && continue
        [ -z "$sha" ] && continue
        size=$(git cat-file -s "$sha" 2>/dev/null || echo 0)
        if [ "$size" -gt "$MAX_SIZE" ]; then
            echo -e "${RED}⚠ Large file: $path ($(numfmt --to=iec-i "$size" 2>/dev/null || echo "${size} bytes"))${NC}"
            LARGE_COUNT=$((LARGE_COUNT + 1))
        fi
    done
done

if [ "$LARGE_COUNT" -gt 0 ]; then
    echo -e "${RED}❌ Found $LARGE_COUNT large file(s). Push rejected.${NC}"
    exit 1
fi
echo "   ✅ No large files."

# ─── 3. 测试 ────────────────────────────────────────────────
#
# ⛔ 走 `make test LAYER=...`,不要在这里另写一份 `go test`。
#
# 这里原本直接调 `go test -tags integration ./tests/integration/...`,于是
# 有两个问题同时成立:① 包列表在 scripts/lib/layers.sh 之外又抄了一份;
# ② 少了 `-count=1`,而 blackbox 层起的是**单独构建的 daemon**,go 的缓存
# 看不见那个二进制变了。2026-09-10 的后果:`/api/v1/` 兜底改了鉴权模式后
# TestWeb_UnknownAPIRouteIsNotSwallowed 一直是红的,而这里连续 10 个提交
# 打印 `ok (cached)`,一次都没真跑。-count=1 现在由 run-tests.sh 按层决定。
if [ "$IS_TAG_PUSH" = true ]; then
    echo "→ SemVer tag push detected, running ALL tests..."
    (cd "$REPO_ROOT" && make test LAYER=all) || exit 1
else
    echo "→ Running blackbox layer..."
    (cd "$REPO_ROOT" && make test LAYER=blackbox) || exit 1
fi

echo "✅ All pre-push checks passed."
